.env
.docker/
.claude/
.DS_Store
# foundryctl (scripts/signoz.sh) and what it forges from observability/signoz/casting.yaml
.foundry/
observability/signoz/pours/
observability/signoz/casting.yaml.lock
__pycache__/

# The production environment's settings live on its server, copied from env/production.env.example
deploy/production/env/production.env
# A server that only restores, for a drill (RESPALDOS.md): a copy of its environment with BACKUPS=off
deploy/production/env/drill.env

# Secrets of the production stack (deploy/production): they live encrypted outside the repository
secrets.env
*.sops.yaml
.sops.yaml
*.pem

# The end-to-end runs (e2e/run.sh): their logs and, with --keep, the throwaway credentials
e2e/artifacts/
e2e/.env.run
e2e/.certificate.p12
