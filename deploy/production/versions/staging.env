# The versions staging runs (S8.2): one tag of each repository, published to GHCR by its release
# workflow. Changing one is a PR (CI checks it against COMPATIBILITY.md); scripts/deploy.sh staging
# deploys what this file says. A pre-release (0.2.0-rc.1) fits here; production takes final ones.
INFRA_VERSION=0.2.0-rc.3
CORE_VERSION=0.1.0
INVOICING_VERSION=0.1.0
WEB_VERSION=0.1.0
