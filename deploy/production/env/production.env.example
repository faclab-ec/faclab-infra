# Production: copy it to env/production.env on the server and fill in the <...> values. Nothing
# here is secret: the passwords and keys are in /etc/faclab/secrets.env and /etc/faclab/secrets
# (scripts/secrets.sh). Every variable compose.yaml reads, with its default, is listed there. The
# versions are in ../versions/production.env, versioned (S8.2).
ENVIRONMENT=production

# D-9: the web and /otlp on APP_DOMAIN; core and invoicing on API_DOMAIN. Both A records point to
# the server (no AAAA: README, "DNS")
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Let's Encrypt; ACME_EMAIL receives the expiry notices
CADDY_TLS_MODE=acme
ACME_EMAIL=ops@example.com
HSTS_MAX_AGE=31536000
CSP_HEADER=Content-Security-Policy

INTEGRATION_ENVIRONMENT=production

# Where the images of core, invoicing, web, the edge Caddy and PostgreSQL come from (S8.2)
# IMAGE_REGISTRY=ghcr.io/faclab-ec

# Kafka: a new base64 UUID per cluster, fixed for the life of its volume:
#   python3 -c "import uuid,base64; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
KAFKA_CLUSTER_ID=<base64 UUID>
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RETENTION_MS=604800000

# SigNoz (D-1, S8.6): its OTLP gRPC receiver, with TLS
SIGNOZ_OTLP_ENDPOINT=<host:4317>
SIGNOZ_OTLP_INSECURE=false

# Backups (S8.3, RESPALDOS.md): an S3-compatible service outside the server, with two buckets
# (PostgreSQL's, and the documents' with versioning and Object Lock in compliance mode for the legal
# term). The keys and passphrases are secrets (secrets.env)
BACKUPS=on
BACKUP_S3_ENDPOINT=<s3 host of the provider>
BACKUP_S3_REGION=<region>
# BACKUP_S3_PORT=443
# path (bucket/key) or host (bucket.host/key)
# BACKUP_S3_URI_STYLE=path
BACKUP_PG_BUCKET=<bucket of pgBackRest>
BACKUP_OBJECTS_BUCKET=<bucket of the documents>
# Full backups kept: one a week, so 4 is four to five weeks of point-in-time recovery
# BACKUP_PG_RETENTION_FULL=4
# At most this many seconds between a write and its WAL leaving the server (the RPO)
# POSTGRES_ARCHIVE_TIMEOUT=60

# Mail (D-3): the SMTP provider, with SPF, DKIM and DMARC of the platform's domain. SMTP_USER and
# SMTP_PASSWORD are secrets (secrets.env)
EMAIL_ENABLED=true
EMAIL_FROM=Faclab <no-reply@example.com>
INVOICE_EMAIL_ENABLED=true
INVOICE_EMAIL_FROM=Faclab <facturas@example.com>
SMTP_HOST=<smtp host>
SMTP_PORT=587

# RUC of the provider of the invoicing software (Anexo 26 of the SRI, G-81)
INVOICING_PROVIDER_RUC=<RUC>

# Memory: the defaults are for 4 vCPU and 8 GB (README, "Recursos"). Uncomment to change one
# POSTGRES_MEMORY=1536m
# POSTGRES_SHARED_BUFFERS=384MB
# CORE_API_MEMORY=768m
# CORE_WEB_CONCURRENCY=2

# Limits by client IP, per minute (Caddy)
# RATE_LIMIT_API_EVENTS=1200
# RATE_LIMIT_LOGIN_EVENTS=20
# RATE_LIMIT_APP_EVENTS=600
# RATE_LIMIT_OTLP_EVENTS=120
