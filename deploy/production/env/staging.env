# Staging of the S8.1 test: a clean OrbStack machine (README, "Staging en una VM local"). Nothing
# here is secret: the passwords and keys are in /etc/faclab/secrets.env and /etc/faclab/secrets.
ENVIRONMENT=staging

# D-9: the web and /otlp on APP_DOMAIN; core and invoicing on API_DOMAIN. In staging, names of the
# reserved .test domain in the /etc/hosts of the machines that open it
APP_DOMAIN=app.faclab.test
API_DOMAIN=api.faclab.test

# Caddy's own certificate authority: there is no public DNS for ACME
CADDY_TLS_MODE=internal
ACME_EMAIL=
# HSTS short: browsers remember it, and the staging names change
HSTS_MAX_AGE=300
CSP_HEADER=Content-Security-Policy

# Images built on the server from these refs (compose.build.yml) until S8.2 publishes them
IMAGES_FROM=git
CORE_REF=15c777635f3ee19329bfc6f82c265dad29897256
INVOICING_REF=78d6ca0c9979ec118f97b1af46139604d9c90ba3
WEB_REF=8af06ca3bcc1ce12bae638d00753d6409011eff4
CORE_IMAGE=faclab-local/core:${CORE_REF}
INVOICING_IMAGE=faclab-local/invoicing:${INVOICING_REF}
WEB_IMAGE=faclab-local/web:${WEB_REF}

# Integration clients fl_test_ (core); the sandbox is this same stack (faclab-core docs/sandbox.md)
INTEGRATION_ENVIRONMENT=sandbox

# Kafka: CLUSTER_ID of this cluster (any base64 UUID, fixed for the life of its volume)
KAFKA_CLUSTER_ID=LDRsOg3xSwm8DWyXP9Eu8A
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RETENTION_MS=604800000

# No SigNoz for staging yet (S8.6): the Collector retries and drops what doesn't fit its queue
SIGNOZ_OTLP_ENDPOINT=signoz.invalid:4317
SIGNOZ_OTLP_INSECURE=true

# No mail provider in staging (D-3): core and invoicing send nothing. faclab-invoicing in production
# requires STARTTLS, so a development server like Mailpit doesn't fit
EMAIL_ENABLED=false
INVOICE_EMAIL_ENABLED=false
