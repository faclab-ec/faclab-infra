# Staging of the S8.1 test: a clean OrbStack machine (README, "Staging en una VM local"). Nothing
# here is secret: the passwords and keys are in /etc/faclab/secrets.env and /etc/faclab/secrets. The
# versions it runs are in ../versions/staging.env (S8.2).
ENVIRONMENT=staging

# D-9: the web and /otlp on APP_DOMAIN; core and invoicing on API_DOMAIN. In staging, names of the
# reserved .test domain in the /etc/hosts of the machines that open it
APP_DOMAIN=app.faclab.test
API_DOMAIN=api.faclab.test

# Caddy's own certificate authority: there is no public DNS for ACME
CADDY_TLS_MODE=internal
ACME_EMAIL=
# HSTS short: browsers remember it, and the staging names change
HSTS_MAX_AGE=300
CSP_HEADER=Content-Security-Policy

# Integration clients fl_test_ (core); the sandbox is this same stack (faclab-core docs/sandbox.md)
INTEGRATION_ENVIRONMENT=sandbox

# Kafka: CLUSTER_ID of this cluster (any base64 UUID, fixed for the life of its volume)
KAFKA_CLUSTER_ID=LDRsOg3xSwm8DWyXP9Eu8A
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RETENTION_MS=604800000

# No SigNoz of its own for staging yet (S8.6): the Collector of faclab-infra on the Mac that runs the
# VM, which forwards to the local SigNoz when it is up (OBSERVABILITY.md of the core). While it isn't,
# the Collector retries and drops what doesn't fit its queue
SIGNOZ_OTLP_ENDPOINT=host.orb.internal:4317
SIGNOZ_OTLP_INSECURE=true

# Backups (S8.3, RESPALDOS.md). Off until the first VPS brings the real provider: S8.3 tested them
# here against the S3 stand-in of drill/ on the Mac (versitygw), which isn't always running. To test
# them again, BACKUPS=on and standin.sh up. Its certificate is self-signed: the only place where TLS
# verification is off
BACKUPS=off
BACKUP_S3_ENDPOINT=host.orb.internal
BACKUP_S3_PORT=9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_VERIFY_TLS=n
BACKUP_PG_BUCKET=faclab-staging-pgbackrest
BACKUP_OBJECTS_BUCKET=faclab-staging-comprobantes

# No mail provider in staging (D-3): core and invoicing send nothing. faclab-invoicing in production
# requires STARTTLS, so a development server like Mailpit doesn't fit
EMAIL_ENABLED=false
INVOICE_EMAIL_ENABLED=false
