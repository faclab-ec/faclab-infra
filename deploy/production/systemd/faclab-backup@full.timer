# Faclab backups (S8.3, deploy/production/RESPALDOS.md): full backup of PostgreSQL, Sundays at 02:00
# in Ecuador. scripts/backups.sh install-timers installs it. The time zone of the calendar is
# explicit: the server's own doesn't matter
[Unit]
Description=Faclab backup: full backup of PostgreSQL

[Timer]
OnCalendar=Sun *-*-* 02:00:00 America/Guayaquil
# A run missed while the server was off happens when it starts
Persistent=true
RandomizedDelaySec=10min
AccuracySec=1min

[Install]
WantedBy=timers.target
