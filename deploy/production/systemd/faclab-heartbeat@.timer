# Faclab heartbeats (S8.6): each check, every 5 minutes. Healthchecks.io's period for each check is
# 5 minutes with a grace of 10: two missed pings in a row raise it
[Unit]
Description=Faclab heartbeat: %i

[Timer]
OnCalendar=*:0/5
# Frequent: a missed run isn't repeated, the next one comes soon
Persistent=false
RandomizedDelaySec=30s
AccuracySec=1min

[Install]
WantedBy=timers.target
