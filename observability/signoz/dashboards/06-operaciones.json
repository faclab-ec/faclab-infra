{
  "schemaVersion": "v6",
  "name": "faclab-operaciones",
  "tags": [
    {
      "key": "faclab",
      "value": "observabilidad"
    }
  ],
  "spec": {
    "display": {
      "name": "Faclab · Calidad de operaciones",
      "description": "¿Qué operaciones de negocio necesitan intervención? Ventas, stock, conciliación, webhooks y logins."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "env",
          "display": {
            "name": "Entorno",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "deployment.environment.name",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "sales-failed": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Ventas fallidas por código",
            "description": "Consulta: faclab.sales.failed por error.code y faclab.sale.source. Unidad: ventas por intervalo. Umbral: informativo. Acción: INTERNAL_ERROR: ver la traza; un código de negocio repetido: hablar con la empresa"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.sales.failed",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "error.code",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "faclab.sale.source",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{faclab.sale.source}} {{error.code}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "sales-confirmed": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Ventas confirmadas",
            "description": "Consulta: faclab.sales.confirmed por faclab.sale.source. Unidad: ventas por intervalo. Umbral: informativo: una caída anormal es un problema. Acción: comparar con las ventas fallidas"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.sales.confirmed",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "faclab.sale.source",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{faclab.sale.source}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "stock-rejections": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rechazos de stock",
            "description": "Consulta: faclab.inventory.stock_rejections por faclab.movement.source. Unidad: rechazos por intervalo. Umbral: informativo. Acción: muchos en sale: stock desactualizado, revisar ajustes"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.inventory.stock_rejections",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "faclab.movement.source",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{faclab.movement.source}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "cancellations": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Anulaciones y devoluciones",
            "description": "Consulta: faclab.sales.cancelled y faclab.refunds.completed por faclab.sale.source. Unidad: documentos por intervalo. Umbral: informativo. Acción: un aumento brusco merece hablar con la empresa"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "composite",
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "source": "",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "metricName": "faclab.sales.cancelled",
                              "temporality": "",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "deployment.environment.name IN $env"
                          },
                          "groupBy": [
                            {
                              "name": "faclab.sale.source",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "anuladas {{faclab.sale.source}}"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "source": "",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "metricName": "faclab.refunds.completed",
                              "temporality": "",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "deployment.environment.name IN $env"
                          },
                          "groupBy": [
                            {
                              "name": "faclab.sale.source",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "devoluciones {{faclab.sale.source}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "discrepancies": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Discrepancias de conciliación",
            "description": "Consulta: faclab.reconciliation.discrepancies por kind. Unidad: discrepancias abiertas. Umbral: > 0 durante 30 min (alerta conciliacion). Acción: usar el listado de conciliación (runbook conciliacion)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": [
                {
                  "value": 0,
                  "unit": "",
                  "color": "#F1575F",
                  "label": "> 0"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.reconciliation.discrepancies",
                        "temporality": "",
                        "timeAggregation": "latest",
                        "spaceAggregation": "max"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "kind",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{kind}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "webhooks": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Entregas de webhooks",
            "description": "Consulta: faclab.webhooks.deliveries por result (delivered, retry, failed). Unidad: entregas por intervalo. Umbral: failed merece revisión. Acción: el endpoint del integrador; tras fallas sostenidas se desactiva solo"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.webhooks.deliveries",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "result",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{result}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "invoice-deliveries": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Entregas de facturas fallidas",
            "description": "Consulta: faclab.invoices.deliveries con result failed o bounced. Unidad: entregas por intervalo. Umbral: > 0 en 1 h (alerta entregas-fallidas). Acción: runbook entregas-fallidas"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": [
                {
                  "value": 0,
                  "unit": "",
                  "color": "#F1575F",
                  "label": "> 0"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.invoices.deliveries",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env AND result IN ('failed', 'bounced')"
                    },
                    "groupBy": [
                      {
                        "name": "result",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{result}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "logins": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Intentos de login",
            "description": "Consulta: faclab.auth.login.attempts por result (success, invalid, locked, no_tenant). Unidad: intentos por intervalo. Umbral: más de 50 invalid o locked en 5 min (alerta fuerza-bruta). Acción: runbook fuerza-bruta"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
