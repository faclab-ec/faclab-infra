                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.auth.login.attempts",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "result",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{result}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Ventas e inventario",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/sales-failed"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/sales-confirmed"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/stock-rejections"
              }
            },
            {
              "x": 6,
              "y": 6,
              "width": 6,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/cancellations"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Integraciones y seguridad",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/discrepancies"
              }
            },
            {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/webhooks"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/invoice-deliveries"
              }
            },
            {
              "x": 0,
              "y": 5,
              "width": 12,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/logins"
              }
            }
          ]
        }
      }
    ],
    "duration": "1h",
    "refreshInterval": "1m",
    "links": []
  }
}
