                        "temporality": "",
                        "timeAggregation": "",
                        "spaceAggregation": "p95"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "messaging.destination.name",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{messaging.destination.name}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
