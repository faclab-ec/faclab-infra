    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Productores",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/outbox-pending"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/outbox-age"
              }
            },
            {
              "x": 0,
              "y": 5,
              "width": 6,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/sent"
              }
            },
            {
              "x": 6,
              "y": 5,
              "width": 6,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/outbox-failed"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Consumidores",
