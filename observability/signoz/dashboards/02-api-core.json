{
  "schemaVersion": "v6",
  "name": "faclab-api-core",
  "tags": [
    {
      "key": "faclab",
      "value": "observabilidad"
    }
  ],
  "spec": {
    "display": {
      "name": "Faclab · API Core",
      "description": "¿Qué endpoint o dependencia degrada la experiencia? Rutas, comandos, SQL y pool del core."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "env",
          "display": {
            "name": "Entorno",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "deployment.environment.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "route",
          "display": {
            "name": "Ruta",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "http.route",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "method",
          "display": {
            "name": "Método",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "http.request.method",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "requests": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Solicitudes por ruta",
            "description": "Consulta: tasa de http.server.request.duration.count de faclab-core por http.route. Unidad: solicitudes por segundo. Umbral: informativo. Acción: comparar con el p95 de la misma ruta"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "http.server.request.duration.count",
                        "temporality": "",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env AND service.name = 'faclab-core' AND http.route IN $route AND http.request.method IN $method"
                    },
                    "groupBy": [
                      {
                        "name": "http.route",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{http.route}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
