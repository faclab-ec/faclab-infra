              "thresholds": [
                {
                  "value": 0.9,
                  "unit": "percentunit",
                  "color": "#F1575F",
                  "label": "90 %"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "system.memory.utilization",
                        "temporality": "",
                        "timeAggregation": "avg",
                        "spaceAggregation": "max"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env AND host.name IN $host AND state = 'used'"
                    },
                    "groupBy": [
                      {
                        "name": "host.name",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{host.name}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "disk": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Disco del host",
            "description": "Consulta: system.filesystem.utilization por mountpoint. Unidad: fracción. Umbral: 0,8 advertencia, 0,9 crítica (alerta disco). Acción: runbook disco"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
