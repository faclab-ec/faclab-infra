{
  "schemaVersion": "v6",
  "name": "faclab-infraestructura",
  "tags": [
    {
      "key": "faclab",
      "value": "observabilidad"
    }
  ],
  "spec": {
    "display": {
      "name": "Faclab · Base de datos e infraestructura",
      "description": "¿Hay saturación de recursos? Host, contenedores, PostgreSQL y Kafka."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "env",
          "display": {
            "name": "Entorno",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "deployment.environment.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "host",
          "display": {
            "name": "Host",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "host.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "container",
          "display": {
            "name": "Contenedor",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "container.name",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU del host",
            "description": "Consulta: 1 menos system.cpu.utilization en estado idle, promedio de los núcleos. Unidad: fracción. Umbral: informativo; sostenida sobre 0,8 merece revisión. Acción: revisar qué contenedor la usa"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": [
                {
                  "value": 0.8,
                  "unit": "percentunit",
                  "color": "#FFA940",
                  "label": "80 %"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "composite",
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "source": "",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "metricName": "system.cpu.utilization",
                              "temporality": "",
                              "timeAggregation": "avg",
                              "spaceAggregation": "avg"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "deployment.environment.name IN $env AND host.name IN $host AND state = 'idle'"
                          },
                          "groupBy": [
                            {
                              "name": "host.name",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "1 - A",
                          "disabled": false,
                          "legend": "{{host.name}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memoria del host",
            "description": "Consulta: system.memory.utilization en estado used. Unidad: fracción. Umbral: 0,9. Acción: revisar la memoria por contenedor"
