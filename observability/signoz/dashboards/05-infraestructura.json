              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": [
                {
                  "value": 0.8,
                  "unit": "percentunit",
                  "color": "#FFA940",
                  "label": "80 %"
                },
                {
                  "value": 0.9,
                  "unit": "percentunit",
                  "color": "#F1575F",
                  "label": "90 %"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "system.filesystem.utilization",
                        "temporality": "",
                        "timeAggregation": "latest",
                        "spaceAggregation": "max"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env AND host.name IN $host"
                    },
                    "groupBy": [
                      {
                        "name": "host.name",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "mountpoint",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{host.name}} {{mountpoint}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "container-cpu": {
