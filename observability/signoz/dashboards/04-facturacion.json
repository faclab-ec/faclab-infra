                              "metricName": "faclab.invoices.pending",
                              "temporality": "",
                              "timeAggregation": "latest",
                              "spaceAggregation": "max"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "deployment.environment.name IN $env AND faclab.issue.type = 'none'"
                          },
                          "groupBy": [
                            {
                              "name": "status",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "{{status}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
