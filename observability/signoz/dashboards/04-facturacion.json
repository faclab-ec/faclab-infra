{
  "schemaVersion": "v6",
  "name": "faclab-facturacion",
  "tags": [
    {
      "key": "faclab",
      "value": "observabilidad"
    }
  ],
  "spec": {
    "display": {
      "name": "Faclab · Facturación electrónica",
      "description": "¿Se están autorizando los comprobantes a tiempo? Cola, SRI, rechazos, entregas y certificados."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "env",
          "display": {
            "name": "Entorno",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "deployment.environment.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "sri",
          "display": {
            "name": "Ambiente SRI",
            "description": ""
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "faclab.sri.environment",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "transitions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Transiciones por estado",
            "description": "Consulta: faclab.invoices.transitions por estado destino y tipo de documento. Unidad: transiciones por intervalo. Umbral: informativo. Acción: si no hay authorized, mirar pendientes y el SRI"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "faclab.invoices.transitions",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment.name IN $env"
                    },
                    "groupBy": [
                      {
                        "name": "to",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "faclab.document.type",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{faclab.document.type}} → {{to}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "pending": {
        "kind": "Panel",
