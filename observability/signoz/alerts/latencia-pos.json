{
  "alert": "Latencia del POS",
  "alertType": "METRIC_BASED_ALERT",
  "description": "El p95 de las rutas /api/pos/sales* de faclab-core pasa de 1,5 s en promedio durante 10 minutos.",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "http.server.request.duration.bucket",
                "temporality": "",
                "timeAggregation": "",
                "spaceAggregation": "p95"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": "service.name = 'faclab-core' AND http.route LIKE '/api/pos/sales%'"
            },
            "groupBy": [
              {
                "name": "deployment.environment.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "order": [],
            "having": {
              "expression": ""
            },
            "functions": [],
            "legend": ""
          }
        }
      ],
      "unit": "s"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "op": "above",
          "matchType": "on_average",
          "target": 1.5,
          "channels": [
            "faclab-correo"
          ]
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "10m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "deployment.environment.name"
    ],
    "usePolicy": false,
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    }
  },
  "labels": {
    "faclab_rule": "latencia-pos"
  },
  "annotations": {
    "summary": "Latencia del POS",
    "description": "El p95 de las rutas /api/pos/sales* de faclab-core pasa de 1,5 s en promedio durante 10 minutos. Valor: {{$value}} (umbral {{$threshold}}). Runbook: https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/latencia-pos.md",
    "runbook_url": "https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/latencia-pos.md"
  },
  "disabled": false
}
