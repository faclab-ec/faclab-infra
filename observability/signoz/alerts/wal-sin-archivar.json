      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    }
  },
  "labels": {
    "faclab_rule": "wal-sin-archivar"
  },
  "annotations": {
    "summary": "WAL sin archivar",
    "description": "PostgreSQL no logra archivar el WAL fuera del servidor desde hace 15 minutos (faclab.backup.wal.failing): la recuperación a un punto en el tiempo pierde lo escrito desde entonces y el WAL se acumula en el disco. Valor: {{$value}} (umbral {{$threshold}}). Runbook: https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/respaldos.md",
    "runbook_url": "https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/respaldos.md"
