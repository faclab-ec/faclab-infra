      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "faclab.backup.wal.failing",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "deployment.environment.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "order": [],
            "having": {
              "expression": ""
            },
            "functions": [],
            "legend": ""
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "op": "above",
          "matchType": "all_the_times",
          "target": 0,
          "channels": [
