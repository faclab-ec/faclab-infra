{
  "alert": "Discrepancias de conciliación abiertas",
  "alertType": "METRIC_BASED_ALERT",
  "description": "Hay discrepancias de conciliación entre el core y facturación abiertas durante 30 minutos.",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "faclab.reconciliation.discrepancies",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "kind",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "deployment.environment.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "order": [],
            "having": {
              "expression": ""
            },
            "functions": [],
            "legend": ""
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "op": "above",
          "matchType": "all_the_times",
          "target": 0,
          "channels": [
            "faclab-correo"
          ]
        }
      ]
    },
    "requireMinPoints": true,
    "requiredNumPoints": 22
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "30m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "kind"
    ],
    "usePolicy": false,
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    }
  },
  "labels": {
    "faclab_rule": "conciliacion"
  },
  "annotations": {
    "summary": "Discrepancias de conciliación abiertas",
    "description": "Hay discrepancias de conciliación entre el core y facturación abiertas durante 30 minutos. Valor: {{$value}} (umbral {{$threshold}}). Runbook: https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/conciliacion.md",
    "runbook_url": "https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/conciliacion.md"
  },
  "disabled": false
}
