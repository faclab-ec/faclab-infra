{
  "alert": "Facturas atascadas",
  "alertType": "METRIC_BASED_ALERT",
  "description": "Hay comprobantes sin estado final que llegaron hace más de 30 minutos.",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "faclab.invoices.oldest_age",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "status",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "deployment.environment.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "order": [],
            "having": {
              "expression": ""
            },
            "functions": [],
            "legend": ""
          }
        }
      ],
      "unit": "s"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "op": "above",
          "matchType": "last",
          "target": 1800,
          "channels": [
            "faclab-correo"
          ]
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "status"
    ],
    "usePolicy": false,
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    }
  },
  "labels": {
    "faclab_rule": "facturas-atascadas"
  },
  "annotations": {
    "summary": "Facturas atascadas",
    "description": "Hay comprobantes sin estado final que llegaron hace más de 30 minutos. Valor: {{$value}} (umbral {{$threshold}}). Runbook: https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/facturas-atascadas.md",
    "runbook_url": "https://github.com/faclab-ec/faclab-infra/blob/master/observability/runbooks/facturas-atascadas.md"
  },
  "disabled": false
}
